From: dev <dev@example.com>
Date: Sat, 3 Oct 2026 18:49:24 +0000
Subject: [PATCH] Phase 1: validate against task, fix hotel price, fail loudly
 on missing ranker, fixture ranker for tests

---
 advanced/counterfactual_search.py |  9 +++---
 agent/agent.py                    | 13 ++++++--
 tests/conftest.py                 | 12 +++++++
 tests/fixtures/ranker.json        | 53 +++++++++++++++++++++++++++++++
 4 files changed, 81 insertions(+), 6 deletions(-)
 create mode 100644 tests/fixtures/ranker.json

diff --git a/advanced/counterfactual_search.py b/advanced/counterfactual_search.py
index 0444eef..b74d1ea 100644
--- a/advanced/counterfactual_search.py
+++ b/advanced/counterfactual_search.py
@@ -30,10 +30,11 @@ def load_ranker(model_path: str = "data/models/ranker.json") -> Dict[str, Any]:
     Loads the Phase 4 ranker model.
     """
     if not os.path.exists(model_path):
-        return {
-            "weights": {},
-            "bias": 0.0,
-        }
+        raise FileNotFoundError(
+            f"Ranker model not found at {model_path!r}. Run `python run_all.py` "
+            "(or generate_training_dataset.py then train_ranker.py) first. "
+            "Refusing to fall back to empty weights: that silently blames the first step."
+        )
 
     with open(model_path, "r", encoding="utf-8") as f:
         return json.load(f)
diff --git a/agent/agent.py b/agent/agent.py
index 6840c8b..d5c8e8a 100644
--- a/agent/agent.py
+++ b/agent/agent.py
@@ -249,13 +249,22 @@ class TravelAgent:
                 "booking_id": "BK-1000",
                 "flight": selected_flight,
                 "hotel": selected_hotel,
-                "total_price": selected_flight.get("price", 0) + selected_hotel.get("price", 0),
+                "total_price": selected_flight.get("price", 0) + selected_hotel.get("price_per_night", selected_hotel.get("price", 0)),
             }
         state["booking"] = booking
         return {"booking": booking}
 
     def _validate_final_result(self, state: Dict[str, Any]) -> Dict[str, Any]:
-        constraints = state.get("constraints", {})
+        # Validate against the immutable task, NOT state["constraints"]: faults
+        # corrupt that state, and checking it against itself hides the failure.
+        t = self.task
+        constraints = {
+            "origin": t.get("origin"),
+            "destination": t.get("destination"),
+            "date": t.get("date"),
+            "flight_price_max": t.get("budget", 0),
+            "hotel_checkin_after": t.get("hotel_checkin_after", "00:00"),
+        }
         booking = state.get("booking")
         violations = []
 
diff --git a/tests/conftest.py b/tests/conftest.py
index fe5df85..2058156 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -1,3 +1,5 @@
+import os
+
 import pytest
 
 from agent.agent import TravelAgent
@@ -30,3 +32,13 @@ def make_trace(tmp_path, task):
         return trace, str(tmp_path)
 
     return _make
+
+
+@pytest.fixture(autouse=True)
+def _ranker_fixture(monkeypatch):
+    """Tests use a committed ranker so they never depend on pipeline order."""
+    import advanced.counterfactual_search as cs
+
+    path = os.path.join(os.path.dirname(__file__), "fixtures", "ranker.json")
+    original = cs.load_ranker
+    monkeypatch.setattr(cs, "load_ranker", lambda model_path=path: original(model_path))
